# Permora local development/test configuration. Copy to .env.local and replace
# placeholders locally. Never store production URLs here, commit .env.local, or
# put secrets in NEXT_PUBLIC_* variables.

APP_URL=http://localhost:3000
# Comma-separated exact HTTP(S) origins trusted by Better Auth. Do not use wildcards.
# For Vercel Preview, include the exact deployment origin and preserve the production origin.
# BETTER_AUTH_TRUSTED_ORIGINS=https://permora.vercel.app,https://preview-deployment.example.vercel.app

# Restricted development runtime connection: data reads/writes only, no schema
# ownership. Database CLIs verify that this and DATABASE_MIGRATION_URL target the
# same protocol, database, and host (allowing Neon direct/pooler host variants).
DATABASE_URL=postgresql://permora_app:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@127.0.0.1:5432/permora_dev?sslmode=disable

# Development schema owner used only by explicit migration and administrator CLI
# commands. Use --database-target development for these local values.
DATABASE_MIGRATION_URL=postgresql://permora_migrator:REPLACE_WITH_LOCAL_MIGRATION_PASSWORD@127.0.0.1:5432/permora_dev?sslmode=disable

# Isolated destructive-test database. --database-target test uses only this value,
# and the database name must end in _test.
TEST_DATABASE_URL=postgresql://permora_test:REPLACE_WITH_LOCAL_TEST_PASSWORD@127.0.0.1:5432/permora_test?sslmode=disable

# Generate locally with: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_RANDOM_SECRET

# Production database CLIs require DATABASE_URL and DATABASE_MIGRATION_URL to be
# injected explicitly into the current process together with
# --database-target production --confirm-production. Do not put production URLs
# in this file.

# Optional shared secret for the protected scheduled-maintenance endpoint
# (POST /api/maintenance/expire-activations). When UNSET the endpoint is
# disabled (503) and never open. Set a high-entropy value (>=16 chars) only in
# an environment where you intend to run the automatic expiration job, and send
# it as `Authorization: Bearer <secret>` (e.g. from a Vercel Cron job). Do not
# enable this in production without approval.
# MAINTENANCE_SCHEDULER_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_SCHEDULER_SECRET

# Future institutional integrations remain unset until approved.
# SIS_API_BASE_URL=https://REPLACE_WITH_APPROVED_SIS_API
# SIS_API_TOKEN=REPLACE_WITH_SERVER_ONLY_TOKEN
# LMS_API_BASE_URL=https://REPLACE_WITH_APPROVED_LMS_API
# LMS_API_TOKEN=REPLACE_WITH_SERVER_ONLY_TOKEN
# RESEARCH_DIRECTORY_API_BASE_URL=https://REPLACE_WITH_APPROVED_RESEARCH_API
# RESEARCH_DIRECTORY_API_TOKEN=REPLACE_WITH_SERVER_ONLY_TOKEN
